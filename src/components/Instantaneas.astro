---
import { ARTIST, SOCIAL } from '../config';
import Icon from './Icon.astro';

const videos = [
  {
    id: 'Ks-qjrH_aDs',
    title: 'Saxofón en vivo — ejemplo de performance',
    src: 'https://www.youtube-nocookie.com/embed/Ks-qjrH_aDs',
  },
  {
    id: 'XBWyE1v8--I',
    title: 'Saxofón callejero — ejemplo de show en vivo',
    src: 'https://www.youtube-nocookie.com/embed/XBWyE1v8--I',
  },
];

const shots = [
  {
    src: 'https://images.unsplash.com/photo-1511192336575-5a79af67a629?q=80&w=1000&auto=format&fit=crop',
    alt: 'Saxofón dorado en primer plano',
    tilt: '-rotate-3',
    wide: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1465847899084-d164df4dedc6?q=80&w=1000&auto=format&fit=crop',
    alt: 'Trío de músicos en un bar',
    tilt: 'rotate-2',
    wide: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?q=80&w=1000&auto=format&fit=crop',
    alt: 'Escenario con luces cálidas',
    tilt: '-rotate-2',
    wide: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1000&auto=format&fit=crop',
    alt: 'Micrófono en una fiesta privada',
    tilt: 'rotate-3',
    wide: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1502773860571-211a597d6e4b?q=80&w=1000&auto=format&fit=crop',
    alt: 'Evento al aire libre al atardecer',
    tilt: '-rotate-1',
    wide: true,
  },
];

const igShots = [
  'https://images.unsplash.com/photo-1511192336575-5a79af67a629?q=80&w=600&h=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1465847899084-d164df4dedc6?q=80&w=600&h=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?q=80&w=600&h=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=600&h=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1502773860571-211a597d6e4b?q=80&w=600&h=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1551918120-9739cb430c6d?q=80&w=600&h=600&auto=format&fit=crop',
];
---

<section id="instantaneas" class="relative overflow-hidden bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div data-reveal>
      <p class="font-display text-xs font-bold uppercase tracking-[0.25em] text-coral-deep">
        ( Instantáneas )
      </p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl font-extrabold uppercase leading-[1.02] tracking-tight md:text-5xl">
        Momentos que ya <span class="text-coral">sonaron</span>
      </h2>
      <p class="mt-4 max-w-xl text-lg text-ink-soft">
        Un vistazo a shows, eventos y sonidos en vivo. Todo lo real está en mis redes.
      </p>
    </div>

    {/* videos */}
    <div class="mt-12 grid gap-6 md:grid-cols-2" data-reveal>
      {videos.map((v, i) => (
        <figure class="group" style={`transition-delay:${i * 100}ms`}>
          <div class="overflow-hidden rounded-[1.75rem] border-2 border-ink bg-night shadow-hard">
            <div class="relative aspect-video w-full">
              <iframe
                src={v.src}
                title={v.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="absolute inset-0 size-full"
              ></iframe>
            </div>
          </div>
          <figcaption class="mt-3 flex items-center gap-2 font-display text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink/55">
            <span class="h-1.5 w-1.5 rounded-full bg-coral"></span>
            En vivo
          </figcaption>
        </figure>
      ))}
    </div>

    {/* fotos */}
    <div class="mt-16" data-reveal>
      <h3 class="flex items-center gap-3 font-display text-xl font-extrabold uppercase">
        <Icon name="play" class="size-6 text-coral" />
        En el escenario
      </h3>
      <div class="mt-6 grid grid-cols-2 gap-5 md:grid-cols-5">
        {shots.map((s) => (
          <figure
            class={`${s.tilt} overflow-hidden rounded-3xl border-2 border-ink bg-paper shadow-hard transition-transform duration-500 hover:rotate-0 hover:scale-[1.03] ${
              s.wide ? 'col-span-2' : 'col-span-1'
            }`}
          >
            <img
              src={s.src}
              alt={s.alt}
              class={`w-full object-cover ${s.wide ? 'aspect-[4/3]' : 'aspect-[3/4]'}`}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>

    {/* instagram */}
    <div class="mt-16 rounded-[2.5rem] border-2 border-ink bg-gold-soft p-6 shadow-hard md:p-10" data-reveal>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <span class="grid size-14 place-items-center rounded-2xl bg-[linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)] text-white">
            <Icon name="instagram" class="size-7" />
          </span>
          <div>
            <p class="font-display text-xl font-extrabold uppercase">{ARTIST.instagram}</p>
            <p class="text-sm font-semibold text-ink/60">Videos, shows y novedades en vivo</p>
          </div>
        </div>
        <a
          href={SOCIAL.instagram}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-6 py-3 font-display text-sm font-bold uppercase shadow-hard transition-all hover:-translate-y-0.5 hover:shadow-lift"
        >
          <Icon name="instagram" class="size-5 text-[#e1306c]" />
          Seguir ahora
        </a>
      </div>

      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-6">
        {igShots.map((src, i) => (
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener"
            class="group relative overflow-hidden rounded-2xl border-2 border-ink"
            aria-label={`Ver publicación en Instagram (${i + 1})`}
          >
            <img
              src={src}
              alt={`Publicación de Instagram de ejemplo ${i + 1}`}
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <span class="absolute inset-0 grid place-items-center bg-night/0 text-white opacity-0 transition-all duration-300 group-hover:bg-night/50 group-hover:opacity-100">
              <span class="flex items-center gap-2 font-display text-xs font-bold uppercase">
                ♥ Ver post
              </span>
            </span>
          </a>
        ))}
      </div>
  </div>
</section>