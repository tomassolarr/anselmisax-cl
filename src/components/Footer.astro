---
import { ARTIST, SOCIAL, waLink } from '../config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="relative bg-night py-12 text-paper">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row md:items-start">
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-full bg-gold font-display text-lg font-extrabold text-ink">
          A♪
        </span>
        <div class="leading-tight">
          <p class="font-display text-lg font-extrabold uppercase">AnselmiSax</p>
          <p class="text-xs font-semibold text-paper/55">Saxofonista & educadora · {ARTIST.city}</p>
        </div>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-semibold text-paper/70">
        <a href="#eventos" class="transition-colors hover:text-gold">Eventos</a>
        <a href="#clases" class="transition-colors hover:text-gold">Clases</a>
        <a href="#sobre-mi" class="transition-colors hover:text-gold">Sobre mí</a>
        <a href="#contacto" class="transition-colors hover:text-gold">Contacto</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram"
          class="group grid size-10 place-items-center rounded-full border border-paper/30 transition-all hover:border-transparent hover:bg-[var(--ic)]"
          style="--ic:#e1306c">
          <Icon name="instagram" class="size-4.5 text-[var(--ic)] group-hover:text-white" />
        </a>
        <a href={SOCIAL.tiktok} target="_blank" rel="noopener" aria-label="TikTok"
          class="group grid size-10 place-items-center rounded-full border border-paper/30 transition-all hover:border-transparent hover:bg-[var(--ic)]"
          style="--ic:#fe2c55">
          <Icon name="tiktok" class="size-4.5 text-[var(--ic)] group-hover:text-white" />
        </a>
        <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube"
          class="group grid size-10 place-items-center rounded-full border border-paper/30 transition-all hover:border-transparent hover:bg-[var(--ic)]"
          style="--ic:#ff0000">
          <Icon name="youtube" class="size-4.5 text-[var(--ic)] group-hover:text-white" />
        </a>
        <a href={waLink('¡Hola Javiera! 👋')} target="_blank" rel="noopener" aria-label="WhatsApp"
          class="group grid size-10 place-items-center rounded-full border border-paper/30 transition-all hover:border-transparent hover:bg-[var(--ic)]"
          style="--ic:#25d366">
          <Icon name="whatsapp" class="size-4.5 text-[var(--ic)] group-hover:text-white" />
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-paper/10 pt-6 text-xs font-medium text-paper/45 md:flex-row">
      <p>© {year} AnselmiSax · anselmisax.cl · Hecho con ♪ en Chile</p>
      <p>Fotos de referencia — reemplazables por material real.</p>
    </div>
  </div>
</footer>