---
import { ARTIST, SOCIAL, waLink } from '../config';
import Icon from './Icon.astro';

const notes = [
  { c: 'text-paper/30', l: 'left-[6%] top-[18%]', s: 'text-3xl', d: '0s' },
  { c: 'text-gold/70', l: 'right-[10%] top-[22%]', s: 'text-4xl', d: '4s' },
  { c: 'text-paper/30', l: 'left-[14%] bottom-[16%]', s: 'text-2xl', d: '7s' },
  { c: 'text-gold/70', l: 'right-[6%] bottom-[26%]', s: 'text-3xl', d: '2s' },
];
---

<section id="contacto" class="relative overflow-hidden bg-coral py-24 text-paper md:py-32">
  {notes.map((n) => (
    <span
      class={`pointer-events-none absolute ${n.l} ${n.c} ${n.s} animate-float select-none`}
      style={`animation-delay:${n.d}; --tilt:-8deg`}
      aria-hidden="true"
    >
      ♪
    </span>
  ))}

  <div class="relative mx-auto max-w-7xl px-4 text-center md:px-8">
    <p class="font-display text-xs font-bold uppercase tracking-[0.3em] text-paper/80" data-reveal>
      ( Contacto )
    </p>
    <h2 class="mx-auto mt-4 max-w-3xl font-display text-4xl font-extrabold uppercase leading-[0.95] tracking-tight md:text-7xl" data-reveal>
      ¿Hablemos
      <span class="text-stroke-paper">de tu</span>
      evento?
    </h2>
<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-paper/85" data-reveal>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec maximus nibh a urna ullamcorper,
        vitae tristique lectus cursus. Integer porta ante eu risus fermentum, sed vestibulum dolor
        posuere.
      </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal>
      <a
        href={waLink('¡Hola Javiera! Quiero cotizar música en vivo 🎷')}
        target="_blank"
        rel="noopener"
        class="group flex items-center gap-3 rounded-full border-2 border-ink bg-paper px-8 py-5 font-display text-base font-extrabold uppercase text-ink shadow-hard transition-all hover:-translate-y-1 hover:shadow-lift md:text-lg"
      >
        <Icon name="whatsapp" class="size-6 text-[#25D366]" />
        Escríbeme por WhatsApp
        <Icon name="arrow" class="size-6 transition-transform duration-300 group-hover:translate-x-1.5" />
      </a>
      <a
        href={`mailto:${ARTIST.email}`}
        class="flex items-center gap-2 rounded-full border-2 border-paper/60 px-7 py-4 font-display text-sm font-bold uppercase text-paper transition-colors hover:bg-paper hover:text-ink"
      >
        {ARTIST.email}
      </a>
    </div>

    <div class="mt-12 flex items-center justify-center gap-4" data-reveal>
      {[
        { href: SOCIAL.instagram, name: 'instagram', label: 'Instagram', c: '#e1306c' },
        { href: SOCIAL.tiktok, name: 'tiktok', label: 'TikTok', c: '#fe2c55' },
        { href: SOCIAL.youtube, name: 'youtube', label: 'YouTube', c: '#ff0000' },
        { href: SOCIAL.spotify, name: 'spotify', label: 'Spotify', c: '#1db954' },
      ].map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.label}
          class="group grid size-13 place-items-center rounded-full border-2 border-ink bg-paper p-3 transition-all hover:-translate-y-1 hover:rotate-6 hover:border-transparent hover:bg-[var(--ic)]"
          style={`--ic:${s.c}`}
        >
          <Icon name={s.name} class="size-6 text-[var(--ic)] group-hover:text-white" />
        </a>
      ))}
    </div>
  </div>
</section>