---
import { waLink } from '../config';
import Icon from './Icon.astro';
---

<a
  href={waLink('¡Hola Javiera! Vi tu página web y quiero preguntarte por tus servicios 🎷')}
  target="_blank"
  rel="noopener"
  class="group fixed bottom-6 right-6 z-50 flex items-center gap-3"
  aria-label="Escríbeme por WhatsApp"
>
  <span class="pointer-events-none relative hidden rounded-full border-2 border-ink bg-paper px-4 py-2 font-display text-xs font-bold uppercase tracking-wider text-ink opacity-0 shadow-hard transition-all duration-300 group-hover:opacity-100 md:block">
    ¿Hablamos? ♪
  </span>

  <span class="relative grid size-16 place-items-center">
    <span class="absolute inset-0 animate-pulse-ring rounded-full bg-[#25D366]/50"></span>
    <span class="relative grid size-16 place-items-center rounded-full border-2 border-ink bg-[#25D366] text-ink shadow-hard transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6">
      <Icon name="whatsapp" class="size-8" />
    </span>
  </span>
</a>