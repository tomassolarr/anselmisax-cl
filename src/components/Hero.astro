---
import { waLink, SOCIAL } from '../config';
import Icon from './Icon.astro';
import Marquee from './Marquee.astro';

const first = ['J', 'A', 'V', 'I', 'E', 'R', 'A'];
const last = ['A', 'N', 'S', 'E', 'L', 'M', 'I'];

const notes = [
  { c: 'text-coral', l: 'left-[8%] top-[16%]', s: 'text-2xl', d: '0s', tilt: '-10deg' },
  { c: 'text-gold', l: 'left-[16%] top-[52%]', s: 'text-3xl', d: '5s', tilt: '12deg' },
  { c: 'text-mint', l: 'right-[6%] top-[30%]', s: 'text-xl', d: '2s', tilt: '8deg' },
  { c: 'text-coral', l: 'right-[18%] bottom-[12%]', s: 'text-3xl', d: '8s', tilt: '-6deg' },
];
---

<header class="relative overflow-hidden pt-28 pb-14 md:pt-32">
  <div
    class="pointer-events-none absolute -left-24 top-24 -z-10 size-96 animate-blob bg-gold/40 blur-2xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -right-20 bottom-0 -z-10 size-80 animate-blob bg-coral/20 blur-2xl"
    style="animation-delay: 6s"
    aria-hidden="true"
  ></div>

  {/* notas flotando */}
  {notes.map((n) => (
    <span
      class={`pointer-events-none absolute ${n.l} ${n.c} ${n.s} animate-float select-none`}
      style={`animation-delay:${n.d}; --tilt:${n.tilt}`}
      aria-hidden="true"
    >
      ♪
    </span>
  ))}

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 md:px-8 lg:grid-cols-12 lg:gap-8">
    {/* ---- columna texto ---- */}
    <div class="lg:col-span-7">
      <p
        class="hero-rise flex items-center gap-3 font-display text-xs font-bold uppercase tracking-[0.25em] text-ink/60"
        style="--rd:0ms"
      >
        <span class="inline-block h-0.5 w-10 rounded-full bg-coral"></span>
        Saxofonista en vivo · Chile
      </p>

      <h1 class="mt-6 font-display leading-[0.86] tracking-tight">
        <span class="hero-rise block" style="--rd:120ms">
          <span class="block text-[clamp(2.4rem,7vw,4.8rem)] font-bold uppercase">
            {first.map((l) => (
              <span class="hero-letter inline-block transition-transform duration-200">{l}</span>
            ))}
          </span>
        </span>
        <span class="hero-rise mt-3 block" style="--rd:240ms">
          <span class="block text-[clamp(3rem,9vw,7rem)] font-extrabold uppercase">
            {last.map((l, i) => (
              <span
                class={`hero-letter inline-block ${i % 2 === 0 ? 'text-ink' : 'text-stroke-coral'}`}
              >
                {l}
              </span>
            ))}
          </span>
          <span class="mt-4 block h-2 w-28 rounded-full bg-coral md:w-40"></span>
        </span>
      </h1>

      <p
        class="hero-rise mt-8 max-w-xl text-lg leading-relaxed text-ink-soft md:text-xl"
        style="--rd:360ms"
      >
        Soy <strong class="text-ink">Javiera Anselmi</strong>. Saxofonista profesional de la{' '}
        <strong class="text-ink">Universidad de Chile</strong> con más de 10 años de experiencia en
        importantes escenarios del país junto a destacados artistas: <strong class="text-ink">Shakira</strong>,{' '}
        <strong class="text-ink">Stewart Copeland (The Police)</strong>, <strong class="text-ink">Luis Jara</strong>,{' '}
        <strong class="text-ink">31 Minutos</strong>, entre otros.
      </p>

      <div class="hero-rise mt-10 flex flex-wrap items-center gap-4" style="--rd:480ms">
        <a
          href={waLink('¡Hola Javiera! Quiero cotizar saxofón en vivo para mi evento.')}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-3 rounded-full border-2 border-ink bg-coral px-7 py-4 font-display text-sm font-bold uppercase text-paper shadow-hard transition-all hover:-translate-y-1 hover:shadow-lift"
        >
          Cotiza tu evento
          <Icon name="arrow" class="size-5 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
        <a
          href="#clases"
          class="flex items-center gap-3 rounded-full border-2 border-ink bg-paper px-7 py-4 font-display text-sm font-bold uppercase transition-all hover:-translate-y-1 hover:bg-ink hover:text-paper"
        >
          Quiero clases
          <Icon name="note" class="size-5" />
        </a>
      </div>

      <div class="hero-rise mt-12 flex flex-wrap items-center gap-3" style="--rd:600ms">
        <span class="font-display text-xs font-bold uppercase tracking-[0.2em] text-ink/50">
          Sígueme
        </span>
        <span class="h-px w-8 bg-ink/20" aria-hidden="true"></span>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram"
          class="grid size-11 place-items-center rounded-full border-2 border-ink bg-paper text-[#e1306c] transition-all hover:-rotate-6 hover:bg-[#e1306c] hover:text-white">
          <Icon name="instagram" class="size-5" />
        </a>
        <a href={SOCIAL.tiktok} target="_blank" rel="noopener" aria-label="TikTok"
          class="grid size-11 place-items-center rounded-full border-2 border-ink bg-paper text-[#fe2c55] transition-all hover:-rotate-6 hover:bg-[#fe2c55] hover:text-white">
          <Icon name="tiktok" class="size-5" />
        </a>
        <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube"
          class="grid size-11 place-items-center rounded-full border-2 border-ink bg-paper text-[#ff0000] transition-all hover:-rotate-6 hover:bg-[#ff0000] hover:text-white">
          <Icon name="youtube" class="size-5" />
        </a>
        <a href={SOCIAL.spotify} target="_blank" rel="noopener" aria-label="Spotify"
          class="grid size-11 place-items-center rounded-full border-2 border-ink bg-paper text-[#1db954] transition-all hover:rotate-6 hover:bg-[#1db954] hover:text-white">
          <Icon name="spotify" class="size-5" />
        </a>
      </div>
    </div>

    {/* ---- columna imagen ---- */}
    <div class="relative mx-auto w-full max-w-md lg:col-span-5" data-reveal>
      {/* foto */}
      <div class="relative rotate-1 overflow-hidden rounded-[2rem] border-2 border-ink bg-white shadow-hard">
        <img
          src="/img/javiera-banner.webp"
          alt="Javiera Anselmi, saxofonista profesional"
          class="aspect-[3/4] w-full object-contain"
          loading="eager"
        />
      </div>

{/* chips flotantes */}
      <div
        class="absolute -left-4 bottom-24 flex animate-float items-center gap-2 rounded-full border-2 border-ink bg-paper px-4 py-2.5 shadow-hard"
        style="--tilt:-3deg"
      >
        <span class="grid size-7 place-items-center rounded-full bg-coral text-paper"><Icon name="note" class="size-4" /></span>
        <div class="leading-tight">
          <p class="font-display text-[0.6rem] font-bold uppercase tracking-wider">Clases online</p>
          <p class="text-xs font-bold">desde $111.111</p>
        </div>
      </div>

      <div
        class="absolute -right-3 top-24 flex animate-float-2 items-center gap-2 rounded-full border-2 border-ink bg-paper px-4 py-2.5 shadow-hard"
        style="--tilt:4deg"
      >
        <span class="font-display text-lg font-black text-coral">+100</span>
        <span class="text-xs font-bold leading-tight text-ink">eventos</span>
      </div>
    </div>
  </div>

  {/* marquesina inferior */}
  <div class="hero-rise mt-14" style="--rd:720ms">
    <Marquee
      items={['Matrimonios', 'Cócteles', 'Eventos corporativos', 'Celebraciones', 'Clases de saxo', 'Shows privados']}
      glyph="♪"
    />
  </div>
</header>

<style>
  .hero-rise {
    opacity: 0;
    animation: hero-rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--rd, 0ms);
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-letter {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .hero-letter:hover {
    transform: translateY(-0.1em) rotate(-3deg) scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise {
      animation: none;
      opacity: 1;
    }
  }
</style>