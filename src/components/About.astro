---
import Marquee from './Marquee.astro';

const stats = [
  { v: '15+', l: 'tocando', d: '0ms' },
  { v: '+100', l: 'eventos', d: '120ms' },
  { v: '+100', l: 'estudiantes', d: '240ms' },
  { v: '24h', l: 'respuesta', d: '360ms' },
];
---

<section id="sobre-mi" class="relative scroll-mt-0 bg-night py-20 text-paper md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      {/* foto */}
      <div class="relative mx-auto w-full max-w-sm lg:col-span-5" data-reveal>
        <div class="rotate-[-2deg] overflow-hidden rounded-[2rem] border-2 border-paper/80 bg-ink shadow-hard transition-transform duration-500 hover:rotate-0">
          <img
            src="https://images.unsplash.com/photo-1511735111819-9a3f7709049c?q=80&w=900&auto=format&fit=crop"
            alt="Javiera Anselmi, saxofonista"
            class="aspect-[4/5] w-full object-cover saturate-[0.8]"
            loading="lazy"
          />
        </div>
        <div class="absolute -bottom-5 -left-3 flex animate-float items-center gap-2 rounded-full border-2 border-paper/60 bg-night px-4 py-2 shadow-hard" style="--tilt:3deg">
          <span class="text-2xl">🎷</span>
          <span class="font-display text-[0.65rem] font-bold uppercase tracking-wider text-gold">
            Conservatorio
            <br />
            & escenario
          </span>
        </div>
      </div>

      {/* texto */}
      <div class="lg:col-span-7">
        <p class="font-display text-xs font-bold uppercase tracking-[0.25em] text-gold" data-reveal>
          ( Sobre mí )
        </p>
        <h2 class="mt-4 font-display text-3xl font-extrabold uppercase leading-[1.02] tracking-tight md:text-5xl" data-reveal>
          Detrás del <span class="text-stroke-paper">sonido</span>.
        </h2>

        <div class="mt-6 max-w-2xl space-y-4 text-[1.05rem] font-medium leading-relaxed text-paper/70" data-reveal>
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec maximus nibh a urna
            ullamcorper, vitae tristique lectus cursus. Integer porta ante eu risus fermentum, sed
            vestibulum dolor posuere. Nulla facilisi.
          </p>
          <p>
            Proin euismod augue ac justo tincidunt, id tincidunt sem volutpat. Ut sagittis metus ac
            suscipit tempus. Pellentesque habitant morbi tristique senectus et netus et malesuada fames
            ac turpis egestas. Curabitur venenatis ligula sed elit tincidunt dictum.
          </p>
          <p>
            Fusce at ligula et augue venenatis scelerisque. Aenean id augue dapibus, ornare augue non,
            venenatis est. Vestibulum ante ipsum primis in faucibus orci luctus.
          </p>
        </div>

        <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map((s) => (
            <div
              class="rounded-2xl border border-paper/15 bg-paper/5 p-4 text-center backdrop-blur-sm transition-colors hover:border-gold/60"
              data-reveal
              style={`--d:${s.d}`}
            >
              <dt class="order-2 mt-1 block font-display text-[0.65rem] font-bold uppercase tracking-[0.2em] text-paper/60">
                {s.l}
              </dt>
              <dd class="order-1 font-display text-3xl font-black text-gold">{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>

  <div class="mt-16 border-t border-paper/10 pt-10">
    <Marquee
      items={['Matrimonios', 'Cócteles', 'Eventos corporativos', 'Celebraciones', 'Clases', 'Lo que venga']}
      glyph="♪"
      className="border-0 bg-transparent text-paper/40"
      speed="animate-marquee-fast"
    />
  </div>
</section>