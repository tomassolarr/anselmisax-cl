---
import { waLink } from '../config';
import Icon from './Icon.astro';

const cards = [
  {
    n: '01',
    title: 'Matrimonios',
    tag: 'El favorito',
    img: 'https://images.unsplash.com/photo-1415201364774-f6f0bb35f28f?q=80&w=1200&auto=format&fit=crop',
    alt: 'Ambientación elegante con velas para un matrimonio',
    chips: ['Ceremonia', 'Cóctel', 'Cena'],
    cls: 'md:col-span-7 md:row-span-2',
    min: 'min-h-[26rem] md:min-h-[30rem]',
    text: 'El momento donde cada nota importa. Ambientación elegante para el gran día, desde la ceremonia hasta el último brindis.',
    wa: waLink('¡Hola Javiera! Quiero pedir cotización de saxofón para mi matrimonio. 💍'),
    delay: '0ms',
  },
  {
    n: '02',
    title: 'Cumpleaños',
    tag: 'Muy pedido',
    img: 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?q=80&w=1200&auto=format&fit=crop',
    alt: 'Celebración con luces y gente festejando',
    chips: ['Fiestas', 'Sorpresas'],
    cls: 'md:col-span-5',
    min: 'min-h-[24rem]',
    text: 'Aparece el saxo, se prende la fiesta.',
    wa: waLink('¡Hola Javiera! Quiero cotizar saxofón para un cumpleaños. 🎂'),
    delay: '120ms',
  },
  {
    n: '03',
    title: 'Corporativos',
    tag: 'Premium',
    img: 'https://images.unsplash.com/photo-1524368535928-5b5e00ddc76b?q=80&w=1200&auto=format&fit=crop',
    alt: 'Escenario en vivo con luces de evento corporativo',
    chips: ['Cenas', 'Lanzamientos'],
    cls: 'md:col-span-5',
    min: 'min-h-[24rem]',
    text: 'Una dosis de clase que tu evento no sabía que necesitaba.',
    wa: waLink('¡Hola Javiera! Quiero cotizar saxofón para un evento corporativo. 🏢'),
    delay: '240ms',
  },
  {
    n: '04',
    title: 'Hoteles & Restaurantes',
    tag: 'Ambient',
    img: 'https://images.unsplash.com/photo-1502773860571-211a597d6e4b?q=80&w=1200&auto=format&fit=crop',
    alt: 'Terraza de restaurante con luces cálidas al atardecer',
    chips: ['Brushes', 'Cocteles'],
    cls: 'md:col-span-4',
    min: 'min-h-[22rem]',
    text: 'Saxo de fondo para espacios con alma.',
    wa: waLink('¡Hola Javiera! Quiero cotizar saxofón para restaurante/hotel. 🍸'),
    delay: '0ms',
  },
  {
    n: '05',
    title: 'Shows privados',
    tag: 'Fiestas',
    img: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=1200&auto=format&fit=crop',
    alt: 'Micrófono en una fiesta privada con luces',
    chips: ['Casas', 'Viñas', 'Terrazas'],
    cls: 'md:col-span-4',
    min: 'min-h-[22rem]',
    text: 'Tu casa, tu gente, tus canciones.',
    wa: waLink('¡Hola Javiera! Quiero cotizar un show privado de saxofón. 🎉'),
    delay: '120ms',
  },
  {
    n: '06',
    title: '¿Tu evento es otro?',
    tag: 'Siempre hay plan B',
    img: '',
    alt: '',
    chips: ['Sorpresas', 'Propuestas', 'Onomásticos', 'Lo que se te ocurra'],
    cls: 'md:col-span-4 bg-ink text-paper',
    min: 'min-h-[22rem]',
    text: 'Cuéntame qué estás planeando y lo hacemos sonar.',
    wa: waLink('¡Hola Javiera! Quiero música en vivo para un evento especial.'),
    delay: '240ms',
  },
];
---

<section id="eventos" class="relative overflow-hidden py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div data-reveal>
        <p class="flex items-center gap-3 font-display text-xs font-bold uppercase tracking-[0.25em] text-coral-deep">
          <span class="inline-block h-0.5 w-10 rounded-full bg-coral"></span>
          ( Eventos )
        </p>
        <h2 class="mt-4 max-w-xl font-display text-3xl font-extrabold uppercase leading-[1.02] tracking-tight md:text-5xl">
          Música en vivo que <span class="text-coral">enciende</span> tu momento
        </h2>
      </div>
      <div class="shrink-0 text-right" data-reveal>
        <p class="max-w-[11rem] font-display text-[0.65rem] font-bold uppercase leading-snug tracking-wider text-ink/60 md:text-xs">
          Solo cupos limitados por fecha
        </p>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-12 md:auto-rows-min">
      {cards.map((c) => (
        <article
          class={`group relative ${c.cls} ${c.min} overflow-hidden rounded-[2rem] border-2 border-ink bg-night shadow-hard transition-all duration-500 hover:-translate-y-1.5 hover:rotate-[0.5deg] hover:shadow-lift`}
          data-reveal
          style={`--d:${c.delay}`}
        >
          {c.img ? (
            <>
              <img
                src={c.img}
                alt={c.alt}
                class="absolute inset-0 size-full object-cover saturate-[0.9] transition-all duration-700 group-hover:scale-110 group-hover:saturate-100"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-ink/10 transition-opacity duration-500"></div>
            </>
          ) : (
            <>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,#2a2118,#17110c_60%)]"></div>
              <span class="absolute -right-6 -top-6 select-none font-display text-[10rem] font-black leading-none text-paper/8" aria-hidden="true">
                {c.n}
              </span>
            </>
          )}

          {/* tag */}
          <span class="absolute left-5 top-5 rounded-full border-2 border-paper/60 bg-night/70 px-4 py-1.5 font-display text-[0.65rem] font-bold uppercase tracking-[0.18em] text-gold backdrop-blur-sm">
            {c.tag}
          </span>

          {/* contratar rápido */}
          <span class="absolute right-5 top-5 grid size-11 -translate-y-2 place-items-center rounded-full bg-paper text-ink opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
            <Icon name="arrow-up" class="size-5" />
          </span>

          {/* contenido */}
          <div class="absolute inset-x-0 bottom-0 p-5 md:p-6">
            <span class="font-display text-[0.65rem] font-bold tracking-[0.25em] text-coral">
              {c.n}.
            </span>
            <h3 class="mt-1 font-display text-2xl font-extrabold uppercase leading-none tracking-tight text-paper transition-transform duration-500 group-hover:-translate-y-1 md:text-3xl">
              {c.title}
            </h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-paper/80">{c.text}</p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {c.chips.map((chip) => (
                <span key={chip} class="rounded-full border border-paper/30 bg-paper/10 px-3 py-1 text-xs font-semibold text-paper backdrop-blur-sm">
                  {chip}
                </span>
              ))}
              <a
                href={c.wa}
                target="_blank"
                rel="noopener"
                class="ml-auto flex items-center gap-2 rounded-full bg-coral px-4 py-2 font-display text-xs font-bold uppercase text-paper transition-all hover:gap-3 hover:bg-paper hover:text-ink"
              >
                Cotizar
                <Icon name="arrow" class="size-4" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-8 flex items-center gap-3 text-sm font-medium text-ink/60" data-reveal>
      <span class="h-2 w-2 shrink-0 animate-pulse rounded-full bg-coral"></span>
      Tarifa según fecha, formato y traslado. Contesto propuestas en menos de 24 horas.
    </p>
  </div>
</section>